{
  "name": "blog",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "astro:check": "astro check",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "eslint:check": "eslint --no-warn-ignored",
    "verify": "bun run --parallel astro:check biome:check eslint:check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "cn": "^0.3.0",
    "reading-time": "^1.5.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.14",
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/typography": "0.5.20",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^3.1.0",
    "astro-og": "^0.3.2",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "lefthook": "2.1.14",
    "typescript": "6.0.3",
    "wrangler": "4.132.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
