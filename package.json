{
  "name": "blog",
  "type": "module",
  "scripts": {
    "astro:check": "astro check",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy",
    "dev": "astro dev",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --max-warnings 0 --fix",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "verify": "bun run --parallel astro:check lint format:check",
    "verify:fix": "bun run --parallel astro:check lint:fix format:fix"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.47.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "nanostores": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@eslint-react/eslint-plugin": "^5.20.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@shadcn/lint": "^0.1.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-og": "^0.3.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "lefthook": "2.1.14",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "4.135.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true
  }
