{
  "name": "blog",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "astro:check": "astro check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "prettier:check": "prettier --check \"**/*.astro\"",
    "prettier:fix": "prettier --write \"**/*.astro\"",
    "verify": "bun run --parallel astro:check lint format:check prettier:check",
    "verify:fix": "bun run --parallel astro:check lint:fix format:fix prettier:fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.47.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "nanostores": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "^1.10.12",
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-og": "^0.3.2",
    "lefthook": "2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "allowScripts": {
    "esbuild": true
  }
}
