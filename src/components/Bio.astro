---
import { Image } from "astro:assets";
---

<div class="flex items-center">
  <Image
    loading="lazy"
    src="/assets/avatar.svg"
    alt=""
    width="100"
    height="100"
    class="mr-5 block size-25 shrink-0 rounded-full bg-muted/15"
  />
  <p class="text-lg">
    Hi, I'm <strong>your name</strong>. Write a sentence or two about yourself
    here, then point people at
    <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
    or wherever else you'd like them to find you.
  </p>
</div>
