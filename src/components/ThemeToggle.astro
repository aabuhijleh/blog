---
import { Moon, Sun } from '@lucide/astro';
import { cn } from 'cn';

const buttonClass = cn(
  'relative ml-2.5 flex cursor-pointer items-center justify-center rounded-full p-2 transition-colors duration-200 hover:bg-muted/15',
);

const sunClass = cn(
  'size-5 rotate-0 scale-100 text-sun transition-all duration-200 dark:-rotate-90 dark:scale-0',
);

const moonClass = cn(
  'absolute size-5 rotate-90 scale-0 text-moon transition-all duration-200 dark:rotate-0 dark:scale-100',
);
---

<button type="button" class={buttonClass} data-theme-toggle>
  <Sun class={sunClass} />
  <Moon class={moonClass} />
  <span class="sr-only">Toggle theme</span>
</button>

<script is:inline data-astro-rerun>
  {
    const button = document.querySelector('[data-theme-toggle]');
    const root = document.documentElement;

    button.addEventListener('click', () => {
      const dark = root.classList.toggle('theme-dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  }
</script>
