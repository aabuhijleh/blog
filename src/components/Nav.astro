---
import { Image } from "astro:assets";
import { cn } from "~/lib/cn";
import NavLink from "./NavLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

const githubClass = cn(
  "flex shrink-0 items-center justify-center rounded-full p-1.5 no-underline transition-colors duration-200 hover:bg-muted/15 sm:p-2",
);

const iconClass = cn("size-4.5 sm:size-5");
---

<nav
  class="flex flex-1 items-center justify-end gap-0.5 font-sans font-bold text-sm uppercase sm:gap-2.5 sm:text-base"
>
  <NavLink href="/">home</NavLink>
  <NavLink href="/about">about</NavLink>
  <NavLink href="/blog">blog</NavLink>
  <a
    href="https://github.com/aabuhijleh"
    target="_blank"
    rel="noopener"
    class={githubClass}
  >
    <Image
      loading="eager"
      src="/assets/logos/github-light.svg"
      alt=""
      width="1024"
      height="1024"
      class={cn(iconClass, "dark:hidden")}
    />
    <Image
      loading="eager"
      src="/assets/logos/github-dark.svg"
      alt=""
      width="1024"
      height="1024"
      class={cn(iconClass, "hidden dark:block")}
    />
    <span class="sr-only">GitHub</span>
  </a>
  <ThemeToggle />
</nav>
