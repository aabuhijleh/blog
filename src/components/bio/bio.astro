---
import { Image } from "astro:assets";

import avatar from "~/assets/icons/avatar.svg";
import { SOCIAL_LINKS } from "~/consts";

import BioLink from "./bio-link.astro";
---

<div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:gap-5 sm:text-left">
  <Image
    loading="lazy"
    src={avatar}
    alt=""
    class="block size-20 shrink-0 rounded-full bg-muted/15 sm:size-25"
  />
  <p class="text-pretty text-base sm:text-lg">
    Hi, I'm <strong>Abed</strong>. I'm a software engineer based in the West Bank. You can see some
    of my work on <BioLink href={SOCIAL_LINKS.github}>GitHub</BioLink>, or read more about me on{" "}
    <BioLink href={SOCIAL_LINKS.website}>my website</BioLink>.
  </p>
</div>
