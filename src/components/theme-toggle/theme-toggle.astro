---
import { Moon, Sun } from "@lucide/astro";
import { cn } from "cn";

import { THEME_STORAGE_KEY } from "./store";

const buttonClass = cn(
  "relative flex shrink-0 cursor-pointer items-center justify-center rounded-full p-1.5 transition-colors duration-200 hover:bg-muted/15 sm:p-2",
);

const sunClass = cn(
  "size-4.5 scale-100 rotate-0 text-sun transition-all duration-200 sm:size-5 dark:scale-0 dark:-rotate-90",
);

const moonClass = cn(
  "absolute size-4.5 scale-0 rotate-90 text-moon transition-all duration-200 sm:size-5 dark:scale-100 dark:rotate-0",
);

const script = `
  {
    const button = document.querySelector("[data-theme-toggle]");
    const root = document.documentElement;

    button.addEventListener("click", () => {
      const dark = root.classList.toggle("theme-dark");
      localStorage.setItem(${JSON.stringify(THEME_STORAGE_KEY)}, dark ? "dark" : "light");
    });
  }
`;
---

<button type="button" class={buttonClass} data-theme-toggle>
  <Sun class={sunClass} />
  <Moon class={moonClass} />
  <span class="sr-only">Toggle theme</span>
</button>

<script is:inline data-astro-rerun set:html={script}></script>
