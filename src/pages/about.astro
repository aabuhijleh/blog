---
import { Image } from "astro:assets";
import codingRocket from "~/assets/illustrations/coding-rocket.svg";
import bun from "~/assets/logos/bun.svg";
import claude from "~/assets/logos/claude.svg";
import reactDark from "~/assets/logos/react-dark.svg";
import reactLight from "~/assets/logos/react-light.svg";
import tailwindcss from "~/assets/logos/tailwindcss.svg";
import tanstackDark from "~/assets/logos/tanstack-dark.svg";
import tanstackLight from "~/assets/logos/tanstack-light.svg";
import turborepoDark from "~/assets/logos/turborepo-dark.svg";
import turborepoLight from "~/assets/logos/turborepo-light.svg";
import typescript from "~/assets/logos/typescript.svg";
import { SOCIAL_LINKS } from "~/consts";
import { BaseLayout } from "~/layouts/base-layout";
import { cn } from "~/lib/cn";

const title = "About";
const description = "Who I am, what I work on, and where else to find me.";

interface Tech {
  name: string;
  href: string;
  src: ImageMetadata;
  darkSrc?: ImageMetadata;
}

const stack: Tech[] = [
  {
    name: "TypeScript",
    href: "https://www.typescriptlang.org",
    src: typescript,
  },
  {
    name: "React",
    href: "https://react.dev",
    src: reactLight,
    darkSrc: reactDark,
  },
  {
    name: "TanStack",
    href: "https://tanstack.com",
    src: tanstackLight,
    darkSrc: tanstackDark,
  },
  {
    name: "Tailwind",
    href: "https://tailwindcss.com",
    src: tailwindcss,
  },
  {
    name: "Bun",
    href: "https://bun.sh",
    src: bun,
  },
  {
    name: "Turborepo",
    href: "https://turborepo.com",
    src: turborepoLight,
    darkSrc: turborepoDark,
  },
  {
    name: "Claude Code",
    href: "https://claude.com/claude-code",
    src: claude,
  },
];

const chipClass = cn(
  "group flex items-center gap-2 rounded-full border border-muted/30 bg-muted/10 px-3 py-1.5 font-sans text-base no-underline transition duration-200 hover:-translate-y-1 hover:rotate-0 hover:border-accent sm:gap-2.5 sm:px-4 sm:py-2 sm:text-lg",
);

const logoClass = cn(
  "h-5 w-auto transition-transform duration-200 group-hover:scale-115 sm:h-6",
);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-2xl">
    <h1 class="mb-10 font-serif font-bold text-h1 sm:mb-12">About</h1>
    <figure
      class="mx-auto mb-8 max-w-55 sm:max-w-75 lg:float-right lg:mx-0 lg:-mt-12 lg:-mr-28 lg:ml-8"
    >
      <Image
        loading="eager"
        src={codingRocket}
        alt="A rocket launching through the clouds with the React logo on its side"
      />
    </figure>
    <div class="prose">
      <p>
        I'm Abed Abu-Hijleh, a software engineer based in the West Bank. I've
        been coding for food since 2018, and for fun since well before that.
      </p>
      <p>My tech stack these days:</p>
    </div>

    <ul class="my-8 flex list-none flex-wrap gap-2.5 p-0 sm:gap-3">
      {stack.map((tech, index) => (
  <li>
    <a
      href={tech.href}
      target="_blank"
      rel="noopener"
      class={cn(chipClass, index % 2 === 0 ? "sm:rotate-2" : "sm:-rotate-2")}
    >
      <Image
        loading="eager"
        src={tech.src}
        alt=""
        class={cn(logoClass, tech.darkSrc && "dark:hidden")}
      />
      {tech.darkSrc && (
        <Image
          loading="eager"
          src={tech.darkSrc}
          alt=""
          class={cn(logoClass, "hidden dark:block")}
        />
      )}
      {tech.name}
    </a>
  </li>
))}
    </ul>

    <div class="prose">
      <p>
        You can see some of my work on
        <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a>,
        find me on
        <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener"
          >LinkedIn</a
        >, follow me on
        <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener">X</a>, or catch
        me on
        <a href={SOCIAL_LINKS.stackOverflow} target="_blank" rel="noopener"
          >Stack Overflow</a
        >
        👴🏼. There's more on
        <a href={SOCIAL_LINKS.website} target="_blank" rel="noopener"
          >my website</a
        >, and you can reach out via
        <a href={SOCIAL_LINKS.email}>email</a>.
      </p>
    </div>
  </div>
</BaseLayout>
