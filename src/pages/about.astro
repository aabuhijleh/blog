---
import BaseLayout from '~/layouts/BaseLayout.astro';

const title = 'About';
const description = 'About this blog and the person writing it.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-2xl">
    <h1
      class="mb-16 font-serif font-bold text-h1 max-lg:mb-12 max-lg:text-5xl/tight"
    >
      About
    </h1>
    <figure
      class="float-right -mt-12 -mr-28 mb-8 ml-8 max-w-75 max-lg:float-none max-lg:mx-auto max-lg:mt-0"
    >
      <img
        src="/assets/illustrations/greetings.svg"
        alt="A person waving hello, surrounded by floating notes"
        width="300"
        height="300"
      >
    </figure>
    <div class="prose">
      <p>
        This is the about page. Replace this copy with your own: who you are,
        what you write about, and why someone should keep reading.
      </p>
      <p>
        The illustration hangs into the right-hand margin on a wide screen and
        moves above the text once the viewport narrows past 1020px.
      </p>
      <p>
        Every illustration and icon on this site, down to the favicon, comes
        from <a href="https://lukaszadam.com">Lukasz Adam's</a> collection, and
        every one of them is an SVG.
      </p>
    </div>
  </div>
</BaseLayout>
