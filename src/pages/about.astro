---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { cn } from "~/lib/cn";

const title = "About";
const description = "Who I am, what I work on, and where else to find me.";

interface Tech {
  name: string;
  href: string;
  src: string;
  darkSrc?: string;
  width: number;
  height: number;
}

const stack: Tech[] = [
  {
    name: "TypeScript",
    href: "https://www.typescriptlang.org",
    src: "/assets/logos/typescript.svg",
    width: 256,
    height: 256,
  },
  {
    name: "React",
    href: "https://react.dev",
    src: "/assets/logos/react-light.svg",
    darkSrc: "/assets/logos/react-dark.svg",
    width: 569,
    height: 512,
  },
  {
    name: "TanStack",
    href: "https://tanstack.com",
    src: "/assets/logos/tanstack-light.svg",
    darkSrc: "/assets/logos/tanstack-dark.svg",
    width: 64,
    height: 84,
  },
  {
    name: "Tailwind",
    href: "https://tailwindcss.com",
    src: "/assets/logos/tailwindcss.svg",
    width: 54,
    height: 33,
  },
  {
    name: "Bun",
    href: "https://bun.sh",
    src: "/assets/logos/bun.svg",
    width: 80,
    height: 70,
  },
  {
    name: "Turborepo",
    href: "https://turborepo.com",
    src: "/assets/logos/turborepo-light.svg",
    darkSrc: "/assets/logos/turborepo-dark.svg",
    width: 100,
    height: 100,
  },
  {
    name: "Claude Code",
    href: "https://claude.com/claude-code",
    src: "/assets/logos/claude.svg",
    width: 256,
    height: 257,
  },
];

const chipClass = cn(
  "group flex items-center gap-2 rounded-full border border-muted/30 bg-muted/10 px-3 py-1.5 font-sans text-base no-underline transition duration-200 hover:-translate-y-1 hover:rotate-0 hover:border-accent sm:gap-2.5 sm:px-4 sm:py-2 sm:text-lg",
);

const logoClass = cn(
  "h-5 w-auto transition-transform duration-200 group-hover:scale-115 sm:h-6",
);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto w-full max-w-2xl">
    <h1 class="mb-10 font-serif font-bold text-h1 sm:mb-12">About</h1>
    <figure
      class="mx-auto mb-8 max-w-55 sm:max-w-75 lg:float-right lg:mx-0 lg:-mt-12 lg:-mr-28 lg:ml-8"
    >
      <Image
        loading="eager"
        src="/assets/illustrations/coding-rocket.svg"
        alt="A rocket launching through the clouds with the React logo on its side"
        width="574"
        height="669"
      />
    </figure>
    <div class="prose">
      <p>
        I'm Abed Abu-Hijleh, a software engineer from the West Bank. I've been
        coding for food since 2018, and for fun since well before that.
      </p>
      <p>My tech stack these days:</p>
    </div>

    <ul class="my-8 flex list-none flex-wrap gap-2.5 p-0 sm:gap-3">
      {stack.map((tech, index) => (
  <li>
    <a
      href={tech.href}
      target="_blank"
      rel="noopener"
      class={cn(chipClass, index % 2 === 0 ? "sm:rotate-2" : "sm:-rotate-2")}
    >
      <Image
        loading="eager"
        src={tech.src}
        alt=""
        width={tech.width}
        height={tech.height}
        class={cn(logoClass, tech.darkSrc && "dark:hidden")}
      />
      {tech.darkSrc && (
        <Image
          loading="eager"
          src={tech.darkSrc}
          alt=""
          width={tech.width}
          height={tech.height}
          class={cn(logoClass, "hidden dark:block")}
        />
      )}
      {tech.name}
    </a>
  </li>
))}
    </ul>

    <div class="prose">
      <p>
        There's more about my work on
        <a href="https://aabuhijleh.com" target="_blank" rel="noopener"
          >my website</a
        >. Otherwise I'm on
        <a href="https://github.com/aabuhijleh" target="_blank" rel="noopener"
          >GitHub</a
        >,
        <a
          href="https://www.linkedin.com/in/aabuhijleh/"
          target="_blank"
          rel="noopener"
          >LinkedIn</a
        >,
        <a href="https://x.com/aabuhijleh_dev" target="_blank" rel="noopener"
          >X</a
        >
        and
        <a
          href="https://stackoverflow.com/users/9698583/aabuhijleh"
          target="_blank"
          rel="noopener"
          >Stack Overflow</a
        >, or one
        <a href="mailto:aabuhijleh.dev@gmail.com">email</a>
        away.
      </p>
    </div>
  </div>
</BaseLayout>
