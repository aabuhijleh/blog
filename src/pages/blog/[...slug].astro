---
import { type CollectionEntry, getCollection, render } from "astro:content";
import readingTime from "reading-time";
import { Bio } from "~/components/bio";
import { FormattedDate } from "~/components/formatted-date";
import { BaseLayout } from "~/layouts/base-layout";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { title, description, pubDate } = post.data;
const { Content } = await render(post);
const estimate = readingTime(post.body ?? "").text;
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/${post.id}.png`}
>
  <header class="text-center">
    <p class="font-bold font-sans text-muted text-sm uppercase sm:text-body">
      <FormattedDate date={pubDate} />~ {estimate}
    </p>
    <h1 class="mb-8 font-serif font-bold text-h1 lg:mb-11">{title}</h1>
    <hr class="squiggle mx-auto my-8 w-3/10 min-w-25 sm:my-10" />
  </header>
  <div class="mx-auto w-full max-w-3xl">
    <article class="prose">
      <Content />
    </article>
    <hr class="squiggle my-10" />
    <Bio />
  </div>
</BaseLayout>
