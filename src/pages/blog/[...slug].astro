---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import Bio from '~/components/Bio.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { title, description, pubDate } = post.data;
const { Content } = await render(post);
const estimate = readingTime(post.body ?? '').text;
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/${post.id}.png`}
>
  <header class="text-center">
    <p class="font-bold font-sans text-body text-muted uppercase">
      <FormattedDate date={pubDate} />
      ~ {estimate}
    </p>
    <h1
      class="mb-11 font-serif font-bold text-h1 max-lg:mb-8 max-lg:text-5xl/tight"
    >
      {title}
    </h1>
    <hr class="squiggle mx-auto my-10 w-3/10 min-w-25">
  </header>
  <div class="mx-auto w-full max-w-2xl">
    <article class="prose">
      <Content />
    </article>
    <hr class="squiggle my-10">
    <Bio />
  </div>
</BaseLayout>
