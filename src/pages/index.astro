---
import { Image } from "astro:assets";
import { SITE_DESCRIPTION, SITE_TITLE } from "~/consts";
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div
    class="my-8 flex min-h-100 flex-1 items-center justify-center max-md:flex-col"
  >
    <div class="flex-1 px-4 max-md:flex-none max-md:pb-8 max-md:text-center">
      <h1
        class="mb-8 font-serif text-h1 font-bold max-lg:mb-6 max-lg:text-5xl/tight"
      >
        Hi, I'm Abed
      </h1>
      <p class="text-h4 leading-body max-lg:text-xl">
        I'm a senior software engineer. I build for the web with TypeScript and
        React, and I write short posts here about problems I ran into and what
        fixed them. <a href="/blog">Start with the latest one</a>.
      </p>
    </div>

    <div class="mx-4 shrink-0 text-center">
      <Image
        loading="eager"
        src="/assets/illustrations/retro-computer.svg"
        alt="A retro desktop computer with a green screen full of code, a keyboard and mouse on the desk"
        width="722"
        height="291"
        class="mb-4 h-auto w-155 max-w-full max-lg:w-120"
      />
    </div>
  </div>
</BaseLayout>
