---
import { SITE_DESCRIPTION, SITE_TITLE } from '~/consts';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div
    class="my-8 flex min-h-100 flex-1 items-center justify-center max-md:flex-col"
  >
    <div class="flex-1 px-4 max-md:flex-none max-md:pb-8 max-md:text-center">
      <h1
        class="mb-8 font-serif text-h1 font-bold max-lg:mb-6 max-lg:text-5xl/tight"
      >
        Welcome to your new Astro blog
      </h1>
      <p class="text-h4 max-lg:text-xl">
        Edit this page in <code>src/pages/index.astro</code> to make it yours.
      </p>
    </div>

    <div class="mx-4 shrink-0 text-center">
      <img
        src="/assets/illustrations/monitor.svg"
        alt="A monitor showing a page layout, with a cat sitting on top of it"
        width="620"
        height="457"
        class="mb-4 h-auto w-155 max-w-full max-lg:w-120"
      >
    </div>
  </div>
</BaseLayout>
