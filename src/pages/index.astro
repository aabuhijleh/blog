---
import { Image } from "astro:assets";
import retroComputer from "~/assets/illustrations/retro-computer.svg";
import { SITE_DESCRIPTION, SITE_TITLE } from "~/consts";
import { BaseLayout } from "~/layouts/base-layout";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="my-8 flex flex-1 flex-col items-center justify-center gap-8 lg:flex-row lg:gap-12">
    <div class="w-full max-w-xl text-center lg:max-w-none lg:flex-1 lg:text-left">
      <h1 class="mb-6 font-serif font-bold text-h1 lg:mb-8">Hi, I'm Abed</h1>
      <p class="text-h4 leading-body">
        I build things for the web. Nowadays, robots write the code for me. I
        write up the problems that kept me up too late.{" "}
        <a class="link-accent" href="/blog">
          Start with the latest one
        </a>
        .
      </p>
    </div>

    <div class="w-full max-w-155 lg:flex-1">
      <Image
        loading="eager"
        src={retroComputer}
        alt="A retro desktop computer with a green screen full of code, a keyboard and mouse on the desk"
        class="h-auto w-full"
      />
    </div>
  </div>
</BaseLayout>
