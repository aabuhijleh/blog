---
import { Image } from "astro:assets";
import catDesk from "~/assets/illustrations/cat-desk.svg";
import { BaseLayout } from "~/layouts/base-layout";
import { cn } from "~/lib/cn";

const title = "404";
const description = "We couldn't find that page you are looking for.";

const linkClass = cn("link-accent font-bold");
---

<BaseLayout title={title} description={description}>
  <div class="my-8 flex flex-1 flex-col items-center justify-center gap-8 lg:flex-row lg:gap-12">
    <div class="w-full max-w-xl text-center lg:max-w-none lg:flex-1 lg:text-left">
      <p class="font-serif font-bold text-accent text-h1 leading-none mb-6">
        Oops!
      </p>
      <h1 class="mt-3 font-serif font-bold text-h2">
        We couldn't find that page you are looking for.
      </h1>
      <p class="mt-4 text-h4 leading-body">
        You can find the blog{" "}
        <a href="/blog" class={linkClass}>
          here
        </a>
        .
      </p>
    </div>

    <div class="w-full max-w-155 lg:flex-1">
      <Image
        loading="eager"
        src={catDesk}
        alt="A cat sitting on a desk beside a monitor showing a web page layout"
        class="h-auto w-full"
      />
    </div>
  </div>
</BaseLayout>
