{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.quickSuggestions": { "strings": "on" },

  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "astro"],
  "biome.enabled": false,

  "tailwindCSS.includeLanguages": { "astro": "html" },
  "tailwindCSS.classAttributes": ["class", "className"],
  "tailwindCSS.classFunctions": ["cn"],

  // TypeScript 7 has no plugin support, which @astrojs/ts-plugin needs
  "js/ts.experimental.useTsgo": false
}
