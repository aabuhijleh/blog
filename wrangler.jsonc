{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blog.aabuhijleh.com", "custom_domain": true }],
  "observability": { "enabled": true },
}
